<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="ClientApp.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid Padding="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="6">
            <TextBlock
                Style="{StaticResource TitleTextBlockStyle}"
                Text="Bell System" />
            <TextBlock
                Opacity="0.75"
                Style="{StaticResource BodyTextBlockStyle}"
                Text="Main dashboard placeholder. This page is meant for the live operational view." />
        </StackPanel>

        <Grid
            Grid.Row="1"
            Margin="0,24,0,0"
            ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                Padding="24"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="16">
                <StackPanel Spacing="16">
                    <TextBlock
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        Text="Playback Overview" />
                    <TextBlock
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="{x:Bind ViewModel.CountText, Mode=OneWay}" />
                    <Button
                        Command="{x:Bind ViewModel.IncrementCommand}"
                        Content="Run sample action"
                        HorizontalAlignment="Left"
                        Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>
            </Border>

            <StackPanel
                Grid.Column="1"
                Spacing="16">
                <Border
                    Padding="20"
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                    CornerRadius="16">
                    <StackPanel Spacing="8">
                        <TextBlock
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="Connection" />
                        <TextBlock Text="Backend reachable" />
                        <InfoBadge Value="1" />
                    </StackPanel>
                </Border>

                <Border
                    Padding="20"
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                    CornerRadius="16">
                    <StackPanel Spacing="8">
                        <TextBlock
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="Next Bell" />
                        <TextBlock Text="08:30 AM" />
                        <TextBlock Opacity="0.7" Text="Morning assembly" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
