<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="ClientApp.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <ScrollViewer>
        <Grid Padding="32,24,32,40">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Spacing="4">
                <TextBlock
                    Style="{StaticResource TitleTextBlockStyle}"
                    Text="Settings" />
                <TextBlock
                    Opacity="0.75"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Text="Windows 11 style settings usually use grouped cards, short supporting text, and roomy spacing instead of dense forms." />
            </StackPanel>

            <StackPanel
                Grid.Row="1"
                Margin="0,28,0,0"
                Spacing="16">
                <Border
                    Padding="20"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="16">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="4">
                            <TextBlock
                                Style="{StaticResource SubtitleTextBlockStyle}"
                                Text="Device" />
                            <TextBlock
                                Opacity="0.7"
                                Text="Identity and behavior for this kiosk client." />
                        </StackPanel>

                        <Grid ColumnSpacing="16" RowSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" VerticalAlignment="Center" Text="Device name" />
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{x:Bind ViewModel.DeviceName, Mode=TwoWay}" />

                            <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="Session role" />
                            <ComboBox Grid.Row="1" Grid.Column="1" SelectedItem="{x:Bind ViewModel.SelectedSession, Mode=TwoWay}">
                                <x:String>Morning</x:String>
                                <x:String>Afternoon</x:String>
                                <x:String>Administrator</x:String>
                            </ComboBox>

                            <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="Start with Windows" />
                            <ToggleSwitch Grid.Row="2" Grid.Column="1" IsOn="{x:Bind ViewModel.LaunchOnStartup, Mode=TwoWay}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border
                    Padding="20"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="16">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="4">
                            <TextBlock
                                Style="{StaticResource SubtitleTextBlockStyle}"
                                Text="Connectivity" />
                            <TextBlock
                                Opacity="0.7"
                                Text="Backend endpoints and local cache location." />
                        </StackPanel>

                        <Grid ColumnSpacing="16" RowSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" VerticalAlignment="Center" Text="Backend API" />
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{x:Bind ViewModel.BackendBaseUrl, Mode=TwoWay}" />

                            <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="Realtime socket" />
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.WebSocketUrl, Mode=TwoWay}" />

                            <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="SQLite cache" />
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.CacheDatabasePath, Mode=TwoWay}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border
                    Padding="20"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="16">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="4">
                            <TextBlock
                                Style="{StaticResource SubtitleTextBlockStyle}"
                                Text="Experience" />
                            <TextBlock
                                Opacity="0.7"
                                Text="Display and audio preferences." />
                        </StackPanel>

                        <Grid ColumnSpacing="16" RowSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" VerticalAlignment="Center" Text="Theme" />
                            <ComboBox Grid.Row="0" Grid.Column="1" SelectedItem="{x:Bind ViewModel.SelectedTheme, Mode=TwoWay}">
                                <x:String>Use system setting</x:String>
                                <x:String>Light</x:String>
                                <x:String>Dark</x:String>
                            </ComboBox>

                            <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="Clock format" />
                            <ToggleSwitch Grid.Row="1" Grid.Column="1" IsOn="{x:Bind ViewModel.Use24HourClock, Mode=TwoWay}" />

                            <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="Audio output" />
                            <ComboBox Grid.Row="2" Grid.Column="1" SelectedItem="{x:Bind ViewModel.SelectedAudioOutput, Mode=TwoWay}">
                                <x:String>Speakers (High Definition Audio)</x:String>
                                <x:String>HDMI Output</x:String>
                                <x:String>USB Audio Device</x:String>
                            </ComboBox>

                            <TextBlock Grid.Row="3" VerticalAlignment="Center" Text="Preview sound" />
                            <ToggleSwitch Grid.Row="3" Grid.Column="1" IsOn="{x:Bind ViewModel.PlayPreviewSound, Mode=TwoWay}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <InfoBar
                Grid.Row="2"
                Margin="0,20,0,0"
                IsOpen="True"
                Message="These controls are placeholder bindings intended to show a WinUI settings layout and page structure."
                Severity="Informational" />
        </Grid>
    </ScrollViewer>
</Page>
