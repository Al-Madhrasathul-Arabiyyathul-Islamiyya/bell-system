#!/usr/bin/env bash
set -e

REPO_ROOT="$(git rev-parse --show-toplevel)"
CHANGED=$(git diff --name-only HEAD @{push} 2>/dev/null || git diff --name-only HEAD~1 HEAD)

# --- Backend (Go) ---
if echo "$CHANGED" | grep -q "^bell-system-backend/"; then
    echo "==> [backend] Running tests..."
    cd "$REPO_ROOT/bell-system-backend"
    go test -race ./... -count=1

    echo "==> [backend] Verifying build..."
    go build ./cmd/server

    cd "$REPO_ROOT"
fi

# --- Admin Client (React/TypeScript) ---
if echo "$CHANGED" | grep -q "^admin-client/"; then
    echo "==> [admin-client] Checks not yet configured."
    # Future: yarn test, yarn build
fi

# --- Desktop Client (.NET) ---
if echo "$CHANGED" | grep -q "^desktop-client/"; then
    echo "==> [desktop-client] Checks not yet configured."
    # Future: dotnet test, dotnet build
fi

echo "==> Pre-push checks passed."
